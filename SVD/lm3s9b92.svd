    <!-- Watchdog timer 0 -->
    <peripheral>
      <name>WDT0</name>
      <version>1.0</version>
      <description>Watchdog timer 0, with 32-bit down counter.</description>
      <groupName>WDT</groupName>
      <headerStructName>WDT</headerStructName>
      <baseAddress>0x40000000</baseAddress>
      
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x00001000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>WDT0</name>
        <description>Watchdog Timer 0 and 1 interrupt.</description>
        <value>18</value>
      </interrupt>
      
      <registers>
        <!-- WDTLOAD: Watchdog Load Register -->
        <register>
          <name>WDTLOAD</name>
          <description>32-bit interval value used by the 32-bit watchdog down-counter.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
        
        <!-- WDTVALUE: Watchdog Value Register -->
        <register>
          <name>WDTVALUE</name>
          <description>32-bit register with the current count value of the timer.</description>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
        </register>
        
        <!-- WDTCTL: Watchdog Control Register -->
        <register>
          <name>WDTCTL</name>
          <description>Watchdog Control Register.</description>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x80000003</resetMask>
          
          <fields>
            <!-- WRC: Write Complete -->
            <field>
              <name>WRC</name>
              <description>Watchdog Timer Write Complete</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>A write access to one of the WDT1 registers is in progress.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ready</name>
                  <description>A write access is not in progress, and WDT registers can be read or written.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            
            <!-- RESEN: Reset Event Enable -->
            <field>
              <name>RESEN</name>
              <description>Watchdog Reset Enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Watchdog Timer reset output is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Watchdog Timer reset output is enabled.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            
            <!-- INTEN: Interrupt Enable -->
            <field>
              <name>INTEN</name>
              <description>Watchdog Interrupt Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Watchdog Timer interrupt event is disabled (once this bit is set, it can only be cleared by a hardware reset).</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Watchdog Timer interrupt event enabled. Once enabled, all writes are ignored.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- WDTICR: Watchdog Interrupt Clear Register -->
        <register>
          <name>ICR</name>
          <description>Watchdog Interrupt Clear Register.</description>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <access>write-only</access>
          
          <resetMask>0x00000000</resetMask>
        </register>
        
        <!-- WDTRIS: Watchdog Raw Interrupt Status Register -->
        <register>
          <name>RIS</name>
          <description>Watchdog Raw Interrupt Status Register.</description>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          <fields>
            <!-- WDTRIS: Watchdog Raw Interrupt Status -->
            <field>
              <name>WDTRIS</name>
              <description>Watchdog Raw Interrupt Status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reset</name>
                  <description>The watchdog has not timed out.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>A watchdog time-out event has occurred.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- WDTMIS: Watchdog Masked Interrupt Status Register -->
        <register>
          <name>WDTMIS</name>
          <description>Watchdog Masked Interrupt Status Register.</description>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <!-- WDTMIS: Watchdog Masked Interrupt Status -->
            <field>
              <name>WDTMIS</name>
              <description>Watchdog Masked Interrupt Status.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Reset</name>
                  <description>The watchdog has not timed out or the watchdog timer interrupt is masked.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>A watchdog time-out event has been signalled to the interrupt controller.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- WDTTEST: Watchdog Test Register -->
        <register>
          <name>WDTTEST</name>
          <description>Watchdog Test Register.</description>
          <addressOffset>0x00000418</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00001000</resetMask>
          
          <fields>
            <!-- STALL: Watchdog Stall Enable -->
            <field>
              <name>STALL</name>
              <description>Watchdog Stall Enable.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>If the microcontroller is stopped with a debugger, the watchdog timer stops counting. Once the microcontroller is restarted, the watchdog timer resumes counting.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>The watchdog timer continues counting if the microcontroller is stopped with a debugger.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- WDTLOCK: Watchdog Lock Register -->
        <register>
          <name>WDTLOCK</name>
          <description>Watchdog Lock Register.</description>
          <addressOffset>0x00000C00</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>WDTLOCK</name>
              <description>Watchdog Lock</description>
              <bitRange>[0:0]</bitRange>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>Unlocked</name>
                  <description>Watchdog registers are unlocked for write access.</description>
                  <value>0x00000000</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Locked</name>
                  <description>Watchdog registers are locked for write access.</description>
                  <value>0x00000001</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    
    <!-- Watchdog timer 1 -->
    <peripheral derivedFrom="WDT0">
        <name>WDT1</name>
        <baseAddress>0x40001000</baseAddress>
    </peripheral>
    

    <!-- System Control -->
    <peripheral>
      <name>SYSCTL</name>
      <version>1.0</version>
      <description>System control configures the overall operation of the device and provides information about the device.</description>
      <baseAddress>0x400FE000</baseAddress>
      <groupName>System Control</groupName>
      
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x000001A4</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>SYSCTL</name>
        <description>System Control interrupt.</description>
        <value>28</value>
      </interrupt>
      
      
      <registers>
      <!-- DID0: Device Identification 0 Register -->
        <register>
          <name>DID0</name>
          <description>Device Identification 0.</description>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x10040000</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <!-- VER: Version field -->
            <field>
              <name>VER</name>
              <description>DID0 Version.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SECOND_DID0_VERSION</name>
                  <description>Second version of the DID0 register format.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- CLASS: Device Class -->
            <field>
              <name>CLASS</name>
              <description>Device Class.</description>
              <bitRange>[23:16]</bitRange>
            </field>
            <!-- MAJOR: Major Revision -->
            <field>
              <name>MAJOR</name>
              <description>Major Revision.</description>
              <bitRange>[15:8]</bitRange>
            </field>
            <!-- MINOR: Major Revision -->
            <field>
              <name>MINOR</name>
              <description>Minor Revision.</description>
              <bitRange>[7:0]</bitRange>
            </field>
          </fields>
        </register>
      <!-- PBORCTL: Brown-Out Reset Control Register -->
        <register>
          <name>PBORCTL</name>
          <description>Brown-Out Reset Control.</description>
          <addressOffset>0x00000030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0x00000002</resetMask>
          <fields>
            <!-- BORIOR: BOR Interrupt or Reset field -->
            <field>
              <name>BORIOR</name>
              <description>BOR Interrupt or Reset.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BORIOR_ON</name>
                  <description>A Brown Out Event causes a reset of the microcontroller.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORIOR_OFF</name>
                  <description>A Brown Out Event causes an interrupt to be generated to the interrupt controller.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      <!-- RIS: Raw Interrupt Status Register -->
        <register>
          <name>RIS</name>
          <description>Raw Interrupt Status.</description>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001C2</resetMask>
          <fields>
            <!-- MOSCPUPRIS: MOSC Power Up Raw Interrupt Status field -->
            <field>
              <name>MOSCPUPRIS</name>
              <description>MOSC Power Up Raw Interrupt Status.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MOSCPUPI_READY</name>
                  <description>Sufficient time has passed for the MOSC to reach the expected frequency. The value for this power-up time is indicated by TMOSC_SETTLE.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOSCPUPI_BUSY</name>
                  <description>Sufficient time has not passed for the MOSC to reach the expected frequency.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- USBPLLLRIS: USB PLL Lock Raw Interrupt Status field -->
            <field>
              <name>USBPLLLRIS</name>
              <description>USB PLL Lock Raw Interrupt Status.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>USBPLLLI_READY</name>
                  <description>The USB PLL timer has reached TREADY indicating that sufficient time has passed for the USB PLL to lock.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USBPLLLI_BUSY</name>
                  <description>The USB PLL timer has not reached TREADY.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- PLLLRIS: PLL Lock Raw Interrupt Status field -->
            <field>
              <name>PLLLRIS</name>
              <description>PLL Lock Raw Interrupt Status.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PLLLI_READY</name>
                  <description>The PLL timer has reached TREADY indicating that sufficient time has passed for the PLL to lock.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLLLI_BUSY</name>
                  <description>The PLL timer has not reached TREADY.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- BORRIS: Brown-Out Reset Raw Interrupt Status field -->
            <field>
              <name>BORRIS</name>
              <description>Brown-Out Reset Raw Interrupt Status.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BORRI_ACTIVE</name>
                  <description>A brown-out condition is currently active.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORRI_INACTIVE</name>
                  <description>A brown-out condition is not currently active.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      <!-- IMC: Interrupt Mask Control Register -->
        <register>
          <name>IMC</name>
          <description>Interrupt Mask Control.</description>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001C2</resetMask>
          <fields>
            <!-- MOSCPUPIM: MOSC Power Up Interrupt Mask field -->
            <field>
              <name>MOSCPUPIM</name>
              <description>MOSC Power Up Interrupt Mask.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MOSCPUPI_ENABLED</name>
                  <description>An interrupt is sent to the interrupt controller when the MOSCPUPRIS bit in the RIS register is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOSCPUPI_SUPPRESSED</name>
                  <description>The MOSCPUPRIS interrupt is suppressed and not sent to the interrupt controller.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- USBPLLLIM: USB PLL Lock Interrupt Mask field -->
            <field>
              <name>USBPLLLIM</name>
              <description>USB PLL Lock Interrupt Mask.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>USBPLLLI_ENABLED</name>
                  <description>An interrupt is sent to the interrupt controller when the USBPLLLRIS bit in the RIS register is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USBPLLLI_SUPPRESSED</name>
                  <description>The USBPLLLRIS interrupt is suppressed and not sent to the interrupt controller.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- PLLLIM: PLL Lock Interrupt Mask field -->
            <field>
              <name>PLLLIM</name>
              <description>PLL Lock Interrupt Mask.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PLLLI_ENABLED</name>
                  <description>An interrupt is sent to the interrupt controller when the PLLLRIS bit in the RIS register is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLLLI_SUPPRESSED</name>
                  <description>The PLLLRIS interrupt is suppressed and not sent to the interrupt controller.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- BORIM: Brown-Out Reset Interrupt Mask field -->
            <field>
              <name>BORIM</name>
              <description>Brown-Out Reset Interrupt Mask.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BORI_ENABLED</name>
                  <description>An interrupt is sent to the interrupt controller when the BORRIS bit in the RIS register is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORI_SUPPRESSED</name>
                  <description>The BORRIS interrupt is suppressed and not sent to the interrupt controller.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      <!-- MISC: Masked Interrupt Status and Clear Register -->
        <register>
          <name>MISC</name>
          <description>Masked Interrupt Status and Clear.</description>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001C2</resetMask>
          <fields>
            <!-- MOSCPUPMIS: MOSC Power Up Masked Interrupt Status field -->
            <field>
              <name>MOSCPUPMIS</name>
              <description>MOSC Power Up Masked Interrupt Status.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>MOSCPUPMI_READY</name>
                  <description>When read, a 1 indicates that an unmasked interrupt was signaled because sufficient time has passed for the MOSC PLL to lock.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOSCPUPMI_BUSY</name>
                  <description>When read, a 0 indicates that sufficient time has not passed for the MOSC PLL to lock.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>MOSCPUPI_CLEAR</name>
                  <description>Writing a 1 to this bit clears it and also the MOSCPUPRIS bit in the RIS register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- USBPLLLMIS: USB PLL Lock Masked Interrupt Status field -->
            <field>
              <name>USBPLLLMIS</name>
              <description>USB PLL Lock Masked Interrupt Status.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>USBPLLLMI_READY</name>
                  <description>When read, a 1 indicates that an unmasked interrupt was signaled because sufficient time has passed for the USB PLL to lock.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USBPLLLMI_BUSY</name>
                  <description>When read, a 0 indicates that sufficient time has not passed for the USB PLL to lock.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>USBPLLLI_CLEAR</name>
                  <description>Writing a 1 to this bit clears it and also the USBPLLLRIS bit in the RIS register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- PLLLMIS: PLL Lock Raw Interrupt Status field -->
            <field>
              <name>PLLLMIS</name>
              <description>PLL Lock Raw Interrupt Status.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PLLLMI_READY</name>
                  <description>When read, a 1 indicates that an unmasked interrupt was signaled because sufficient time has passed for the PLL to lock.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLLLMI_BUSY</name>
                  <description>When read, a 0 indicates that sufficient time has not passed for the PLL to lock.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PLLLI_CLEAR</name>
                  <description>Writing a 1 to this bit clears it and also the PLLLRIS bit in the RIS register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- BORMIS: BOR Masked Interrupt Status field -->
            <field>
              <name>BORMIS</name>
              <description>BOR Masked Interrupt Status.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>BORMI_TRIGGERED</name>
                  <description>When read, a 1 indicates that an unmasked interrupt was signaled because of a brown-out condition.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORMI_NOT_TRIGGERED</name>
                  <description>When read, a 0 indicates that a brown-out condition has not occurred.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>BORI_CLEAR</name>
                  <description>Writing a 1 to this bit clears it and also the PLLLRIS bit in the RIS register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      <!-- RESC: Reset Cause Register -->
        <register>
          <name>RESC</name>
          <description>Reset Cause.</description>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <modifiedWriteValues>zeroToClear</modifiedWriteValues>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001C2</resetMask>
          <fields>
            <!-- MOSCFAIL: MOSC Failure Reset field -->
            <field>
              <name>MOSCFAIL</name>
              <description>MOSC Failure Reset.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>MOSCFAIL_TRIGGERED</name>
                  <description>When read, this bit indicates that the MOSC circuit was enabled for clock validation and failed, generating a reset event.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MOSCFAIL_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that a MOSC failure has not generated a reset since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>MOSCFAIL_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- WDT1: Watchdog Timer 1 Reset field -->
            <field>
              <name>WDT1</name>
              <description>Watchdog Timer 1 Reset.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>WDT1RST_TRIGGERED</name>
                  <description>When read, this bit indicates that Watchdog Timer 1 timed out and generated a reset.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDT1RST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that Watchdog Timer 1 has not generated a reset since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>WDT1RST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- SW: Software Reset field -->
            <field>
              <name>SW</name>
              <description>Software Reset.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>SWRST_TRIGGERED</name>
                  <description>When read, this bit indicates that a software reset has caused a reset event.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWRST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that a software reset has not generated a reset since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>SWRST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- WDT0: Watchdog Timer 0 Reset field -->
            <field>
              <name>WDT0</name>
              <description>Watchdog Timer 0 Reset.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>WDT0RST_TRIGGERED</name>
                  <description>When read, this bit indicates that Watchdog Timer 0 timed out and generated a reset.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDT1RST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that Watchdog Timer 0 has not generated a reset since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>WDT0RST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- BOR: Brown-Out Reset field -->
            <field>
              <name>BOR</name>
              <description>Brown-Out Reset.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>BORRST_TRIGGERED</name>
                  <description>When read, this bit indicates that a brown-out reset has caused a reset event.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORRST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that a brown-out reset has not generated a reset since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>BORRST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- POR: Power-On Reset field -->
            <field>
              <name>POR</name>
              <description>Power-On Reset.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PORRST_TRIGGERED</name>
                  <description>When read, this bit indicates that a power-on reset has caused a reset event.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORRST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that a power-on reset has not generated a reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PORRST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- EXT: External Reset field -->
            <field>
              <name>EXT</name>
              <description>External Reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>EXTRST_TRIGGERED</name>
                  <description>When read, this bit indicates that an external reset (RST assertion) has caused a reset event.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTRST_NOT_TRIGGERED</name>
                  <description>When read, this bit indicates that an external reset (RST assertion) has not caused a reset event since the previous power-on reset.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <usage>write</usage>
                <enumeratedValue>
                  <name>EXTRST_CLEAR</name>
                  <description>Writing a 0 to this bit clears it.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      <!-- RCC: Run-Mode Clock Configuration Register -->
        <register>
          <name>RCC</name>
          <description>Run-Mode Clock Configuration.</description>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x078E3AD1</resetValue>
          <resetMask>0xFDE2FF3</resetMask>
          <fields>
            <!-- ACG: Auto Clock Gating field -->
            <field>
              <name>ACG</name>
              <description>Auto Clock Gating.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>ACG_ENABLE</name>
                  <description>The SCGCn or DCGCn registers are used to control the clocks distributed to the peripherals when the microcontroller is in a sleep mode. The SCGCn and DCGCn registers allow unused peripherals to consume less power when the microcontroller is in a sleep mode.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACG_DISABLE</name>
                  <description>The Run-Mode Clock Gating Control (RCGCn) registers are used when the microcontroller enters a sleep mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- SYSDIV: System Clock Divisor field -->
            <field>
              <name>SYSDIV</name>
              <description>System Clock Divisor.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
