  <cpu>                                                           <!-- details about the cpu embedded in the device -->
    <name>CM3</name>
    <revision>r2p0</revision>
    <endian>little</endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>                            <!-- byte addressable memory -->
  <width>32</width>                                               <!-- bus width is 32 bits -->
  <!-- default settings implicitly inherited by subsequent sections -->
  <size>32</size>                                                 <!-- this is the default size (number of bits) of all peripherals and register that do not define "size" themselves -->
  <access>read-write</access>                                     <!-- default access permission for all subsequent registers -->
  <resetValue>0x00000000</resetValue>                             <!-- by default all bits of the registers are initialized to 0 on reset -->
  <resetMask>0x00000000</resetMask>                               <!-- by default none of 32Bits of the registers are used -->
  
  <peripherals>
    <!-- General purpose input output port A -->
    <peripheral>
      <name>GPIOA</name>
      <version>1.0</version>
      <description>Register map for GPIO PORT A peripheral.</description>
      <groupName>GPIO</groupName>
      <headerStructName>GPIO</headerStructName>
      <baseAddress>0x40004000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x00001000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>GPIOA</name>
        <description>GPIO A interrupt.</description>
        <value>0</value>
      </interrupt>
      
      <registers>
      <!-- DATA: GPIO Data Register -->
        <register>
          <name>DATA[%s]</name>
          <description>Data of GPIO Port.</description>
          <addressOffset>0x0</addressOffset>
          <dim>256</dim>
          <dimIncrement>4</dimIncrement>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>DATA7</name>
              <description>Pin7 data.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>OutputPinWrite</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PIN_SET</name>
                  <description>Set output pin high.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_RESET</name>
                  <description>Set output pin low.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <name>InputPinRead</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PIN_SET</name>
                  <description>Input pin set high.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_RESET</name>
                  <description>Input pin set low.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA6</name>
              <description>Pin6 data.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA5</name>
              <description>Pin5 data.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA4</name>
              <description>Pin4 data.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA3</name>
              <description>Pin3 data.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA2</name>
              <description>Pin2 data.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA1</name>
              <description>Pin1 data.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="DATA7">
              <name>DATA0</name>
              <description>Pin0 data.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- DIR: GPIO Digital Direction Register -->
        <register>
          <name>DIR</name>
          <description>Directions of GPIO Port pins.</description>
          <addressOffset>0x400</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>DIR7</name>
              <description>Pin7 Data Direction.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinDirectionSet</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PIN_OUTPUT</name>
                  <description>Set pin to output.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_INPUT</name>
                  <description>Set pin to input.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <name>PinDirectionGet</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PIN_OUTPUT</name>
                  <description>Pin set as output.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_INPUT</name>
                  <description>Pin set as input.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR6</name>
              <description>Pin6 Data Direction.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR5</name>
              <description>Pin5 Data Direction.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR4</name>
              <description>Pin4 Data Direction.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR3</name>
              <description>Pin3 Data Direction.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR2</name>
              <description>Pin2 Data Direction.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR1</name>
              <description>Pin1 Data Direction.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="DIR7">
              <name>DIR0</name>
              <description>Pin0 Data Direction.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- IS: GPIO Interrupt Sense Register -->
        <register>
          <name>IS</name>
          <description>GPIO Interrupt Sense.</description>
          <addressOffset>0x404</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>IS7</name>
              <description>Pin7 Interrupt Sense.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinDirectionSet</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_LEVEL</name>
                  <description>Set pin interrupt sensitivity to level.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_EDGE</name>
                  <description>Set pin interrupt sensitivity to edge.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
              <enumeratedValues>
                <name>PinDirectionGet</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_LEVEL</name>
                  <description>Pin interrupt sensitivity set to level.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_EDGE</name>
                  <description>Pin interrupt sensitivity set to edge.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="IS7">
              <name>IS6</name>
              <description>Pin6 Interrupt Sense.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS5</name>
              <description>Pin5 Interrupt Sense.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS4</name>
              <description>Pin4 Interrupt Sense.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS3</name>
              <description>Pin3 Interrupt Sense.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS2</name>
              <description>Pin2 Interrupt Sense.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS1</name>
              <description>Pin1 Interrupt Sense.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="IS7">
              <name>IS0</name>
              <description>Pin0 Interrupt Sense.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- IBE: GPIO Interrupt Both Edges Register -->
        <register>
          <name>IBE</name>
          <description>GPIO Interrupt Both Edges.</description>
          <addressOffset>0x408</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>IBE7</name>
              <description>Pin7 Interrupt Both Edges.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptEdgeSensitivitySet</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_SENS_BOTH_EDGES</name>
                  <description>Both edges on the corresponding pin trigger an interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_SENS_IEV</name>
                  <description>Interrupt generation is controlled by the GPIOIEV register.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE6</name>
              <description>Pin6 Interrupt Both Edges.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE5</name>
              <description>Pin5 Interrupt Both Edges.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE4</name>
              <description>Pin4 Interrupt Both Edges.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE3</name>
              <description>Pin3 Interrupt Both Edges.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE2</name>
              <description>Pin2 Interrupt Both Edges.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE1</name>
              <description>Pin1 Interrupt Both Edges.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="IBE7">
              <name>IBE0</name>
              <description>Pin0 Interrupt Both Edges.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- IEV: GPIO Interrupt Event Register -->
        <register>
          <name>IEV</name>
          <description>GPIO Interrupt Event.</description>
          <addressOffset>0x40C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>IEV7</name>
              <description>Pin7 Interrupt Event.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptEventSelect</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_TRIG_RISING_EDGE</name>
                  <description>A rising edge or a High level on the corresponding pin triggers an interrupt.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_TRIG_FALLING_EDGE</name>
                  <description>A falling edge or a Low level on the corresponding pin triggers an interrupt.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV6</name>
              <description>Pin6 Interrupt Event.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV5</name>
              <description>Pin5 Interrupt Event.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV4</name>
              <description>Pin4 Interrupt Event.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV3</name>
              <description>Pin3 Interrupt Event.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV2</name>
              <description>Pin2 Interrupt Event.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV1</name>
              <description>Pin1 Interrupt Event.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="IEV7">
              <name>IEV0</name>
              <description>Pin0 Interrupt Event.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- IM: GPIO Interrupt Mask Register -->
        <register>
          <name>IM</name>
          <description>GPIO Interrupt Mask.</description>
          <addressOffset>0x410</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>IME7</name>
              <description>Pin7 Interrupt Mask Enable.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptMask</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_UNMASKED_PIN</name>
                  <description>The interrupt from the corresponding pin is sent to the interrupt controller.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_MASKED_PIN</name>
                  <description>The interrupt from the corresponding pin is masked.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="IME7">
              <name>IME6</name>
              <description>Pin6 Interrupt Mask Enable.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME5</name>
              <description>Pin5 Interrupt Mask Enable.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME4</name>
              <description>Pin4 Interrupt Mask Enable.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME3</name>
              <description>Pin3 Interrupt Mask Enable.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME2</name>
              <description>Pin2 Interrupt Mask Enable.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME1</name>
              <description>Pin1 Interrupt Mask Enable.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="IME7">
              <name>IME0</name>
              <description>Pin0 Interrupt Mask Enable.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- RIS: GPIO Raw Interrupt Status Register -->
        <register>
          <name>RIS</name>
          <description>GPIO Raw Interrupt Status.</description>
          <addressOffset>0x414</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>RIS7</name>
              <description>Pin7 Interrupt Raw Status.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptRawInterruptStatus</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_PIN_RAW_STATUS_TRUE</name>
                  <description>An interrupt condition has occurred on the corresponding pin.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_PIN_RAW_STATUS_FALSE</name>
                  <description>An interrupt condition has not occurred on the corresponding pin.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS6</name>
              <description>Pin6 Interrupt Raw Status.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS5</name>
              <description>Pin5 Interrupt Raw Status.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS4</name>
              <description>Pin4 Interrupt Raw Status.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS3</name>
              <description>Pin3 Interrupt Raw Status.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS2</name>
              <description>Pin2 Interrupt Raw Status.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS1</name>
              <description>Pin1 Interrupt Raw Status.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="RIS7">
              <name>RIS0</name>
              <description>Pin0 Interrupt Raw Status.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- MIS: GPIO Masked Interrupt Register -->
        <register>
          <name>MIS</name>
          <description>GPIO Mask Interrupt Status.</description>
          <addressOffset>0x418</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>MIS7</name>
              <description>Pin7 Masked Interrupt Status.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptMaskedStatus</name>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_PIN_MASK_STATUS_TRUE</name>
                  <description>An interrupt condition on the corresponding pin has triggered an interrupt to the interrupt controller.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_PIN_MASK_STATUS_FALSE</name>
                  <description>An interrupt condition on the corresponding pin is masked or has not occurred.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS6</name>
              <description>Pin6 Masked Interrupt Status.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS5</name>
              <description>Pin5 Masked Interrupt Status.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS4</name>
              <description>Pin4 Masked Interrupt Status.</description>
              <bitOffset>4</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS3</name>
              <description>Pin3 Masked Interrupt Status.</description>
              <bitOffset>3</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS2</name>
              <description>Pin2 Masked Interrupt Status.</description>
              <bitOffset>2</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS1</name>
              <description>Pin1 Masked Interrupt Status.</description>
              <bitOffset>1</bitOffset>
            </field>
            <field derivedFrom="MIS7">
              <name>MIS0</name>
              <description>Pin0 Masked Interrupt Status.</description>
              <bitOffset>0</bitOffset>
            </field>
          </fields>
        </register>
      <!-- IC: GPIO Interrupt Clear Register -->
        <register>
          <name>IC</name>
          <description>GPIO Interrupt Clear.</description>
          <addressOffset>0x41C</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000ff</resetMask>
          <fields>
            <field>
              <name>IC7</name>
              <description>Pin7 Interrupt Clear.</description>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>

              <enumeratedValues>
                <name>PinInterruptClear</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>PIN_IRQ_CLR</name>
                  <description>The corresponding interrupt is cleared.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PIN_IRQ_NOP</name>
                  <description>The corresponding interrupt is unaffected.</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field derivedFrom="IC7">
              <name>IC6</name>
              <description>Pin6 Interrupt Clear.</description>
              <bitOffset>6</bitOffset>
            </field>
            <field derivedFrom="IC7">
              <name>IC5</name>
              <description>Pin5 Interrupt Clear.</description>
              <bitOffset>5</bitOffset>
            </field>
            <field derivedFrom="IC7">
              <name>IC4</name>
              <description>Pin4 Interrupt Clear.</description>
