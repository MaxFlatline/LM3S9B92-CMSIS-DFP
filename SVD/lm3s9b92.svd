                  <description>Clock source frequency/6.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDIV_7</name>
                  <description>Clock source frequency/7.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDIV_8</name>
                  <description>Clock source frequency/8.</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDIV_9</name>
                  <description>Clock source frequency/9.</description>
                  <value>0x8</value>
