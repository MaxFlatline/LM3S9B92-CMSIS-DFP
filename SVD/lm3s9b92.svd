                <enumeratedValue>
                  <name>PWMDIV_64</name>
                  <description>PWM frequency/64.</description>
                  <value>0x5</value>
                  <isDefault>true</isDefault>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- PWRDN: PLL Power Down field -->
            <field>
              <name>PWRDN</name>
              <description>PLL Power Down.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PLL_POWERED_DOWN</name>
                  <description>The PLL is powered down. Care must be taken to ensure that another clock source is functioning and that the BYPASS bit is set before setting this bit.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL_POWERED_UP</name>
                  <description>The PLL is operating normally.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- BYPASS: PLL Bypass field -->
            <field>
              <name>BYPASS</name>
              <description>PLL Bypass.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read</usage>
                <enumeratedValue>
                  <name>PLL_BYPASS_ENABLED</name>
                  <description>The system clock is derived from the OSC source and divided by the divisor specified by SYSDIV.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL_BYPASS_DISABLED</name>
                  <description>The system clock is the PLL output clock divided by the divisor specified by SYSDIV.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
