                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWMDIV_UNUSED</name>
                  <description>The system clock is the source for the PWM clock.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
