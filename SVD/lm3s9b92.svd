                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDIV_2</name>
                  <description>Clock source frequency/2.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDIV_3</name>
                  <description>Clock source frequency/3.</description>
                  <value>0x2</value>
