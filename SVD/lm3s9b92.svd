                <enumeratedValue>
                  <name>PWMDIV_4</name>
                  <description>PWM frequency/4.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWMDIV_8</name>
                  <description>PWM frequency/8.</description>
                  <value>0x2</value>
