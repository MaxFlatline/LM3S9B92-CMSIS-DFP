      <!-- RCC2: Run-Mode Clock Configuration 2 Register -->
        <register>
          <name>RCC2</name>
          <description>Run-Mode Clock Configuration 2.</description>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x07C06810</resetValue>
          <resetMask>0xDFC06870</resetMask>
          <fields>
            <!-- USERCC2: Use RCC2 field -->
            <field>
              <name>USERCC2</name>
              <description>Use RCC2.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>RCC2_ENABLE</name>
                  <description>The RCC2 register fields override the RCC register fields.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RCC2_DISABLE</name>
                  <description>The RCC register fields are used, and the fields in RCC2 are ignored.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- DIV400: Divide PLL as 400 MHz vs. 200 MHz field -->
            <field>
              <name>DIV400</name>
              <description>Divide PLL as 400 MHz vs. 200 MHz.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>USE_400MHZ_PLL</name>
                  <description>Append the SYSDIV2LSB bit to the SYSDIV2 field to create a 7 bit divisor using the 400 MHz PLL output.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>USE_200MHZ_PLL</name>
                  <description>Use SYSDIV2 as is and apply to 200 MHz predivided PLL output. See Table 6-6 on page 111 for programming guidelines.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- SYSDIV2: System Clock Divisor 2 field -->
            <field>
              <name>SYSDIV2</name>
              <description>System Clock Divisor 2.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>6</bitWidth>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>DIV_1</name>
                  <description>Clock source frequency/2.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV_2</name>
                  <description>Clock source frequency/2.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
