            <!-- PORTJ: Port J Advanced High-Performance Bus field -->
            <field>
              <name>PORTJ</name>
              <description>Port J Advanced High-Performance Bus.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PORT_AHB</name>
                  <description>Advanced High-Performance Bus (AHB)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORT_APB</name>
                  <description>Advanced Peripheral Bus (APB). This bus is the legacy bus.</description>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!-- PORTH: Port H Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTH</name>
              <description>Port H Advanced High-Performance Bus.</description>
              <bitOffset>7</bitOffset>
            </field>
            <!-- PORTG: Port G Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTG</name>
              <description>Port G Advanced High-Performance Bus.</description>
              <bitOffset>6</bitOffset>
            </field>
            <!-- PORTF: Port F Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTF</name>
              <description>Port F Advanced High-Performance Bus.</description>
              <bitOffset>5</bitOffset>
            </field>
            <!-- PORTE: Port E Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTE</name>
              <description>Port E Advanced High-Performance Bus.</description>
              <bitOffset>4</bitOffset>
            </field>
            <!-- PORTD: Port D Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTD</name>
              <description>Port D Advanced High-Performance Bus.</description>
              <bitOffset>3</bitOffset>
            </field>
            <!-- PORTC: Port C Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTC</name>
              <description>Port C Advanced High-Performance Bus.</description>
              <bitOffset>2</bitOffset>
            </field>
            <!-- PORTB: Port B Advanced High-Performance Bus field -->
            <field derivedFrom="PORTJ">
              <name>PORTB</name>
              <description>Port B Advanced High-Performance Bus.</description>
